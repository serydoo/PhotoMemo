  "defaultDeviceName": "iPhone7",
  "defaultScheme": "MemoMarkDeviceQA",
  "qaTarget": "MemoMarkDeviceQA",
  "qaHostProduct": "MemoMarkiOS.app",
  "qaRunnerBundleIdentifier": "com.serydoo.PhotoMemo.MemoMarkDeviceQA.xctrunner",
  "inputPolicy": {
