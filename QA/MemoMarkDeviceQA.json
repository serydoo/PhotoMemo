    { "id": "QA-04", "name": "Live Photo processing and save", "status": "planned" },
    { "id": "QA-05", "name": "48MP/RAW highest-quality processing and readback", "status": "planned" },
    { "id": "QA-06", "name": "Photos to Share Extension to MemoMark", "status": "planned" },
    { "id": "QA-07", "name": "PhotoKit commit-window recovery", "status": "planned" },
    { "id": "QA-08", "name": "Restart and idempotency", "status": "planned" }
  ]
