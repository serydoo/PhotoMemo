"settings.version.release_notes" = "What's New";
"settings.version.release_notes_detail" = "See what has changed in MemoMark.";
"settings.release_notes.header" = "This update closes V3 with more consistent recording, settings, and final results.";
"settings.release_notes.version_format" = "Version %@";
"settings.release_notes.positioning" = "Version 2.0 continues MemoMark's local-first memory presentation: photos stay on this device, are never uploaded, and never replace originals in Apple Photos. This release focuses on making existing flows more reliable, keeping Preview, saving, and final results aligned, and repairing the MemoMark+ purchase entry.";
"settings.release_notes.reliable_recording.title" = "More reliable recording";
"settings.release_notes.reliable_recording.item_one" = "Share intake, saving, recovery, and retry behavior are more dependable, so interrupted records are easier to continue.";
"settings.release_notes.reliable_recording.item_two" = "Background work now distinguishes waiting, recoverable, permission, and completed states instead of treating a temporary interruption as a final failure.";
"settings.release_notes.reliable_recording.item_three" = "Large-library saves are less likely to block, while duplicate protection and unchanged originals remain in place.";
"settings.release_notes.reliable_recording.item_four" = "Queue startup, recovery, retry, notification attachments, and source-file cleanup now use tighter boundaries to reduce lost requests and overwritten recovery states.";
"settings.release_notes.reliable_recording.item_five" = "The Share handoff sheet now uses four native information rows with improved action sizing, VoiceOver semantics, and complete Chinese and English copy.";
"settings.release_notes.configuration_center.title" = "A clearer Configuration Center";
"settings.release_notes.configuration_center.item_one" = "Saving, switching Memory Subjects, renaming Presets, backup, and restore now keep their state boundaries aligned.";
"settings.release_notes.configuration_center.item_two" = "Saved time-display choices now reach the final result; Daily Record dates keep their weekday just as they do in Preview.";
"settings.release_notes.configuration_center.item_three" = "Configuration Preview continues to use the real Memory Card and shares the same time-formatting path as final output.";
"settings.release_notes.advanced_modules.title" = "Advanced Modules and compact screens";
"settings.release_notes.advanced_modules.item_one" = "Advanced Modules continues to contain Location Display and Time Display without expanding the feature surface.";
"settings.release_notes.advanced_modules.item_two" = "The sheet uses a compact 390pt default height with room to expand, and presents Location Display and Time Display as two native list rows.";
"settings.release_notes.advanced_modules.item_three" = "Both modules have more vertical breathing room while preserving native menus, Dynamic Type, and accessibility behavior.";
"settings.release_notes.advanced_modules.item_four" = "On smaller iPhones at standard text sizes, Memory Expression keeps its title and selection on one line whenever space allows.";
"settings.release_notes.advanced_modules.item_five" = "When space is limited or accessibility text sizes are active, the row falls back vertically and keeps the selection sized to its content.";
"settings.release_notes.iphone_and_settings.title" = "iPhone interface and Settings";
"settings.release_notes.iphone_and_settings.item_one" = "Hierarchy, row layout, and primary actions are refined across Home, configuration, saving, processing, output, Memory Subjects, and Time Anchors.";
"settings.release_notes.iphone_and_settings.item_two" = "Compact devices, narrow screens, larger text, and accessibility sizes now have more stable vertical layouts and native menu fallbacks.";
"settings.release_notes.iphone_and_settings.item_three" = "Settings is organized around Getting Started, Photo Processing, Data Safety, Feedback, Community, Interface Language, and About.";
"settings.release_notes.iphone_and_settings.item_four" = "What's New now opens directly inside the app instead of GitHub Releases.";
"settings.release_notes.iphone_and_settings.item_five" = "The interface split continues to keep ConfigurationSession as the editing truth without redesigning the frozen Configuration Center architecture.";
"settings.release_notes.expression_and_language.title" = "Memory expression and language";
"settings.release_notes.expression_and_language.item_one" = "Memory Subjects, important moments, and expression choices now use more natural, restrained narrative language.";
"settings.release_notes.expression_and_language.item_two" = "The Settings expression guide, time-result examples, and supported interface language now work in Chinese and English.";
"settings.release_notes.expression_and_language.item_three" = "Smart content still provides editable time results; you remain in control of the final wording.";
"settings.release_notes.expression_and_language.item_four" = "Permissions, privacy, errors, recovery, purchases, and deletion continue to use direct, precise language.";
"settings.release_notes.unchanged.title" = "What remains unchanged";
"settings.release_notes.unchanged.item_one" = "Photos are processed only on this device and are never uploaded.";
"settings.release_notes.unchanged.item_two" = "Originals in Apple Photos remain unchanged; MemoMark creates a new output photo.";
"settings.release_notes.unchanged.item_three" = "Existing Live Photo processing and output behavior has not been downgraded or redesigned.";
"settings.release_notes.unchanged.item_four" = "The daily flow remains Apple Photos → Share → MemoMark → Processing → Notification → Apple Photos.";
"settings.release_notes.unchanged.item_five" = "The established ownership boundaries across Configuration Center, Memory Engine, presentation, layout, rendering, and export remain unchanged.";
"settings.release_notes.verification.title" = "Verification and release boundaries";
"settings.release_notes.verification.item_one" = "Settings, background processing, responsive layout, narrative language, configuration lifecycle, Share UI, time display, and media output all have focused contract coverage.";
"settings.release_notes.verification.item_two" = "The complete macOS test regression passed 1,214 tests, with 1 skipped and 0 failed.";
"settings.release_notes.verification.item_three" = "macOS, generic iOS, and signed iOS Debug builds passed, including strict embedded-signature checks for the app and extensions.";
"settings.release_notes.verification.item_four" = "Version 2.0 (65) completes MemoMark+ purchase-entry repair before resubmission: purchasing requests Apple's StoreKit service, while an unavailable service explains the issue and keeps retry available.";
"settings.release_notes.verification.item_five" = "Final acceptance of Apple Photos sharing, system background scheduling, VoiceOver, Dynamic Type, Live Photo, and visual details remains tied to the release candidate on physical devices.";
"settings.release_notes.next_stage.title" = "What comes next";
"settings.release_notes.next_stage.item_one" = "Version 2.0 closes V3 product-quality delivery. V4 starts with Expression Style research and continues refining the main interface, existing features, interaction logic, and device fit without a large-scale core-flow or architecture rewrite.";
"settings.release_notes.next_stage.item_two" = "After V4, if no material issues affect normal use, MemoMark will stop routine version updates and retain only necessary maintenance.";
"settings.release_notes.next_stage.item_three" = "Future maintenance will be limited to required compatibility work, Apple platform changes, and material issues affecting normal use.";
"settings.release_notes.closing" = "Thank you for trusting MemoMark with real moments from your life.";
